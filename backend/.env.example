# Smart Inventory System - Backend Environment Examples
# 
# These are examples - never commit real secrets!
# Copy to .env and fill in actual values for development.

# Port for the Express server
PORT=5000

# MongoDB connection URI
# Use 127.0.0.1 for local development (verified TCP connectivity)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_inventory

# CORS origin for frontend communication
CORS_ORIGIN=http://localhost:5173

# JWT secrets (change these for production!)
# JWT_SECRET must be a long random value (32+ characters). The server refuses
# to start when it is missing; never commit a real secret.
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# Application environment
NODE_ENV=development